 "poems": [
  {
   "seq": "1",
   "text": "たつの住澤邊の芦の下ねとけ汀萌出る春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "花さかぬ常盤の山の鶯は霞を見てや春を知らん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "夏山の木高き陰に立よりて見れは千年の影そ有ける",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "龜山の岩はのうへの紅葉はゝちらて秋をそかそふへらなる",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春日野のときはの松は霜のふる年每に猶色まさりつゝ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "君か爲けふきる竹の杖なれはまたつきもせす千代そこもれる",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "引松の千年の春は春日野の若菜も摘む物にやはあらぬ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "雁金そけふ歸るなる小山田の苗代水のひきもとめなん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "散果る花をおしめは大かたの春さへ暮ることをしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "山近みさく卯花を時ならてふる雪とのみあやまたれつゝ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "あやめ草引かけたれは子規ねをくらへにや我宿になく",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "みそきする川のふちせに引網をおほぬさなりと人やみるらん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "棚機にかせる衣のうら返し別てこひんほとのつゆけさ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "むかへくる人もあるかな關山の駒引かへすかけはしるしも",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "かりにとて我宿のへにくる人はいなおほせ鳥にあはんとや思ふ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "紅葉はのよれる網代はあかすして過にし秋のせゝにて有ける",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "榊葉の霜うち拂かれすのみすめとそ祈る神の御前に",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "新き春さへ近く成ゆけはふりのみまさる年のゆきかな",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "さしてくるいなりの山の道とをみ花のあたりに宿やからまし",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "新き春くる〓とに故〓の春日のゝへに若菜をそつむ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "八乙女も霞も友にけふしこそ春日のゝへに立渡るらし",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "すまの浦のもしほの煙春なれはそらに霞の猶や立らん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "草ふかみまたきつけたる蚊遣火とみゆるはふしの煙なりけり",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "住吉の年ふる松のよはひをはかへる〓〓も浪やかそふる",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "誰爲にわたし初けんよさの海の浦に世をふる蜒の橋立",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "漁火のくるれはうかふ影をこそ天津星とそいふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "音に聞すゑの松山けふそは打くる浪のこえ〓〓すみめ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "うき島と名にきゝくれと浪の上に所もさらすよをそへにける",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "紅葉せはあかく成なん小倉山秋まつほとの名にヽそ有らし",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "筏おろし明くれ下す大井川みなれそしつる四方の人さへ",
   "kana": "",
   "speaker": "能宣朝臣集",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "秋〓とに大宮人のくるのへはさかの〓とゝや花もみるらむ",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "女郞花にほふあたりにむつなれはあやなく露や心置らん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "山城の小野の山への里遠みかりのやとりを鳥そ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "紅葉するくりこま山の夕かけをいさ我宿にうつしもたらん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "もみちはの日をへてよれる網代木は錦を橋にわたすとそみる",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "みや人のたける庭火のおきあかし聲〓〓あそふ神のきねかも",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "雪によりかへりやせまししかすかに故〓こひしいさ渡なん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "天の川へたつる中のこひよりも久しき秋をまちや渡らん",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "暮ぬへき春のかたみと思ひつゝ花の雫にぬれん今夜は",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "霞たに立をくれせは新き春のくるともしらすそあらまし",
   "kana": "",
   "speaker": "",
   "page": 325,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "櫻花匂ふあたりの夕くれはあやなく人にあやまたれつゝ",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "はる風の吹ときかたのうす氷底の玉もゝ今やみたるゝ",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "咲ぬれは散事かたき岩つゝし名にはたかはぬ色にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "卯花の咲るあたりは時ならぬ雪ふる里のかきれとそみる",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "時鳥れ覺に聲を聞しよりあやめもしらぬ物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "もゆる火の中の契りを夏虫のいかにせしかは身にもかふらん",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "終夜したもえわたる蚊遣火にこひする人をよそへてそみる",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "東ちにわかゝる萱のみたれつゝ誰爲とかはふきてなひかん",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "秋霧の峯にも尾にも立田山紅葉の錦たまらさるらし",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "女郞花あたにやみをは思ふらん露の心にあやまたれつゝ",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "吾たにも結ひ置ては花すゝきなへて人をはまねきしもせし",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "柚山に立煙こそ神な月しくれをくたす雲となりけれ",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "夜を寒み笆の草を見渡せは今朝そ初霜置にけらしな",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "山川を落くる瀧の音もせす今は氷にとちそしぬらし",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "隱沼の氷のまより下根さし芦のわか葉も今やとくらん",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "霞たにたゝすありせは春きぬと何をしるしに人のとはまし",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "山高み雪ふるすより鶯の出る初音はげふそなくなる",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "匂をは風にそふとも梅花色さへあやなあたにちらすな",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "白雪のまたふる里の春日野にいさうち拂若菜摘てん",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "櫻花またきなちりそ何により春をは人のおしむとか知",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "ともすれは風のよるにそ靑柳の糸は中〓〓みたれそめける",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "いつしかも引人ともや春のゝに生る子日の松は待らん",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "今朝聞は澤の蛙も鳴にけり春のくれにも成ぬへらなり",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "こくれつゝ春の中はに成にけり今や咲らんやま吹の花",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "天の原わきて鳴なる雁金は故〓尋かへるなるへし",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "花ちらは起つゝも見ん常よりもさやけくてらせ春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "我宿の垣根の草の淺綠ふる春雨に色はそめける",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "埋れ木のうへはつれなくありなから下には深き戀もする哉",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "こひ〓〓てあふとも夢に見つる夜はいとゝね覺の恨めしき哉",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "さりともと賴む心にはかられてしなれぬ物は命なりけり",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "人しれぬ戀の道なる關守は忍ひにとひしとにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "草枕われのみならすかり金も旅の空にそ鳴渡るなる",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "水の色も花の匂をけふそへて千年の秋の例とそみる",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "こむらさき句へる藤の花よりはみつなき空に浪そ立ける",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "さま〓〓に山の古巢はこふらめと此とくらには鳴聲もせす",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "時しもあれ春の始に生出たる松は八千世の色をそへけん",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "山櫻千代のはる〓〓ことしより色さき增れ君か見にこは",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "人しれすいりきと思ひしかひもなく年も越ける山ちなりけり",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "引そめて世〓をへにける松なれと綠の色のあせすも有哉",
   "kana": "",
   "speaker": "爲賴朝臣集",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "花の色をよそに見つゝももろともに折し昔の人そこひしき",
   "kana": "",
   "speaker": "",
   "page": 326,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
